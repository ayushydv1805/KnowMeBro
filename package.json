{
  "name": "know-me-bro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "desktop:dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.knowmebro.desktop",
    "productName": "KnowMeBro",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KnowMeBro-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "KnowMeBro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "KnowMeBro-Portable-${version}.${ext}"
    }
  }
}
